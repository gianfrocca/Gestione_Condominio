# ============================================
# ENVIRONMENT VARIABLES - Gestione Condominio
# ============================================
# Copia questo file a .env e compila con i tuoi valori

# ============================================
# SERVER CONFIGURATION
# ============================================
NODE_ENV=production
PORT=3000

# ============================================
# DATABASE CONFIGURATION (PostgreSQL)
# ============================================
# Host del database PostgreSQL
DB_HOST=localhost

# Porta PostgreSQL (default: 5432)
DB_PORT=5432

# Nome database
DB_NAME=condominio_db

# Utente database
DB_USER=condominio_user

# Password database (CAMBIO SUBITO IN PRODUZIONE!)
DB_PASSWORD=your_secure_password_here

# SSL per database (usa 'true' per produzione)
DB_SSL=false

# ============================================
# JWT AUTHENTICATION
# ============================================
# Genera con: openssl rand -base64 32
JWT_SECRET=your_jwt_secret_key_here

# ============================================
# EMAIL CONFIGURATION (Opzionale)
# ============================================
# Provider SMTP (es. smtp.gmail.com)
SMTP_HOST=smtp.gmail.com

# Porta SMTP (es. 587 per TLS, 465 per SSL)
SMTP_PORT=587

# Email mittente
SMTP_USER=your-email@gmail.com

# Password app (non la password account principale!)
SMTP_PASS=your-app-password

# ============================================
# CORS CONFIGURATION
# ============================================
# URL frontend (se diverso da localhost)
CORS_ORIGIN=http://localhost:5173

# ============================================
# NOTE IMPORTANTI
# ============================================
# 1. MAI committare questo file con valori reali - sempre usare .env.example
# 2. In Coolify, imposta queste variabili direttamente nell'interfaccia
# 3. Il JWT_SECRET deve essere lungo e casuale
# 4. La password DB dev'essere sicura (min 12 caratteri, maiuscole/minuscole/numeri/simboli)
# 5. Per email via Gmail: https://myaccount.google.com/apppasswords
